{
  "name": "shoebox",
  "productName": "shoebox",
  "version": "4.0.1",
  "description": "Multimedia browser",
  "main": "main/main.js",
  "type": "module",
  "build": {
    "appId": "com.gmail.marvbudd.shoebox",
    "directories": {
      "app": "app"
    },
    "files": [
      "**/*",
      "!resource/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "app/resource",
        "to": "resource",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "models/**/*"
    ],
    "dmg": {
      "background": null,
      "backgroundColor": "#ffffff",
      "window": {
        "width": "400",
        "height": "300"
      },
      "contents": [
        {
          "x": 100,
          "y": 100
        },
        {
          "x": 300,
          "y": 100,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Marvbudd",
        "repo": "shoebox",
        "releaseType": "release",
        "vPrefixedTagName": true,
        "publishAutoUpdate": true
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "com.marvbudd.media.shoebox"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  },
  "scripts": {
    "start": "./app/node_modules/.bin/electron app/main/main.js",
    "start:face-debug": "SHOEBOX_FACE_DEBUG=1 yarn start",
    "dev": "vite",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build:vue": "yarn build:personManager && yarn build:faceMatching && yarn build:createAccessions && yarn build:mediaManager && yarn build:updateCollection && yarn build:collectionManager && yarn build:mainWindow && yarn build:mediaPlayer && yarn build:collectionSetOperations",
    "build:mainWindow": "./scripts/build-vue.sh mainWindow",
    "build:mediaManager": "./scripts/build-vue.sh mediaManager",
    "build:personManager": "./scripts/build-vue.sh personManager",
    "build:faceMatching": "./scripts/build-vue.sh faceMatching",
    "build:createAccessions": "./scripts/build-vue.sh createAccessions",
    "build:updateCollection": "./scripts/build-vue.sh updateCollection",
    "build:collectionManager": "./scripts/build-vue.sh collectionManager",
    "build:mediaPlayer": "./scripts/build-vue.sh mediaPlayer",
    "build:collectionSetOperations": "./scripts/build-vue.sh collectionSetOperations",
    "preview": "vite preview",
    "pack": "electron-builder --dir",
    "electron-builder": "electron-builder",
    "build": "yarn build:vue && electron-builder build --publish never",
    "deploy": "yarn build:vue && electron-builder build --publish always",
    "dist": "yarn build:vue && electron-builder --publish always",
    "dist:dir": "yarn dist --dir -c.compression=store -c.mac.identity=null",
    "cert": "electron-builder create-self-signed-cert",
    "postinstall": "electron-builder install-app-deps",
    "release": "electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Marvbudd/shoebox.git"
  },
  "postinstall": "electron-builder install-app-deps",
  "keywords": [
    "genealogy",
    "media",
    "video",
    "audio",
    "photo"
  ],
  "author": {
    "name": "Marvin E Budd",
    "email": "marvbudd@gmail.com"
  },
  "license": "MIT",
  "copyright": "Copyright © 2001-2026, Marvin E Budd",
  "dependencies": {
    "canvas": "^3.2.3",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "exifr": "^7.1.3",
    "face-api.js": "^0.22.2",
    "handlebars": "^4.7.9",
    "nconf": "^0.13.0",
    "vite": "^8.2.0",
    "vitepress": "^2.0.0-alpha.19",
    "vue": "^3.5.41"
  },
  "packageManager": "yarn@4.17.1",
  "resolutions": {
    "minimatch": "^10.2.5",
    "rollup": "^4.60.1",
    "esbuild": "^0.28.1",
    "undici": "7.28.0",
    "@electron/get>undici": "7.28.0",
    "node-gyp>undici": "7.28.0"
  },
  "devDependencies": {
    "@algolia/client-search": "^5.56.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "algoliasearch": "^5.57.0",
    "electron": "^40.10.6",
    "electron-builder-squirrel-windows": "26.15.3",
    "search-insights": "^2.17.3"
  }
}
